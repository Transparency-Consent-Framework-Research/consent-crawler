{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "target": "ES2022",
        "outDir": "./dist",
        "noUnusedLocals": false,
        "moduleResolution": "nodenext",                       /* Specify how TypeScript looks up a file from a given module specifier. */
        "skipLibCheck": true,
        "lib": ["DOM", "ES2022"]
    },
    "include": [
        "./src/**/*"
    ]
}
