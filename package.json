{
    "name": "articlecrawler",
    "version": "0.0.1",
    "type": "module",
    "description": "This is an example of a Crawlee project.",
    "dependencies": {
        "@google-cloud/bigquery": "^6.2.0",
        "@iabtcf/core": "^1.5.6",
        "@types/node": "^18.15.10",
        "crawlee": "^3.8.1",
        "dayjs": "^1.11.7",
        "glob": "^11.0.0",
        "playwright": "^1.41.1",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "tc-string-parse": "^1.3.0",
        "wild-wild-utils": "^5.0.0"
    },
    "devDependencies": {
        "@apify/tsconfig": "^0.1.0",
        "tsc-watch": "^6.2.0",
        "tsup": "^8.1.2",
        "typescript": "^5.3.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:scan": "CRAWLEE_AVAILABLE_MEMORY_RATIO=0.75 node -max-old-space-size=8192 dist/scan.js",
        "dev": "tsc-watch --project . --outDir ./dist --onSuccess \"npm run start:prod\"",
        "dev:scan": "ts-node-esm -T src/scan.ts",
        "build": "tsup src/main.ts --out-dir dist --format esm",
        "test": "echo \"Error: oops, the actor has no tests yet, sad!\" && exit 1"
    },
    "author": "It's not you it's me",
    "license": "ISC"
}
